PROJECT_NAME="AI Code Classroom"
API_V1_STR="/api"

# Database Configuration
# For PostgreSQL: postgresql://user:password@localhost:5432/ai_code_classroom
# Development fallback: sqlite:///./ai_code_classroom.db
DATABASE_URL=sqlite:///./ai_code_classroom.db

# JWT Security
SECRET_KEY=super_secret_jwt_key_change_me_in_production_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ollama AI Provider Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=120
AI_MAX_RETRIES=3
AI_PROVIDER_TYPE=ollama


# Debug: keep finished code-runner containers so they show in Docker Desktop (default false)
RUNNER_KEEP_CONTAINERS=false

# Browser origins allowed to call the API directly (JSON list). The Vite dev proxy does not need this.
CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]
