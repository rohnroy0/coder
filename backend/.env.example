PROJECT_NAME="AI Code Classroom"
API_V1_STR="/api"

# Database Configuration
# For PostgreSQL: postgresql://user:password@localhost:5432/ai_code_classroom
# Development fallback: sqlite:///./ai_code_classroom.db
DATABASE_URL=sqlite:///./ai_code_classroom.db

# JWT Security
# IMPORTANT: generate your own value - the server logs a security warning if
# this committed default is left in place (anyone with repo access could forge
# tokens). e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=super_secret_jwt_key_change_me_in_production_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Required code for registering TEACHER accounts. Empty = anyone can register
# as a teacher (fine locally, unsafe for a real deployment).
TEACHER_SIGNUP_CODE=

# AI provider: "ollama" (local), "groq" or "gemini" (hosted, permanent
# rate-limited free tiers - create a free key at console.groq.com or
# aistudio.google.com), or "openai_compat" (any other OpenAI-compatible host).
# With groq/gemini selected, start.ps1 skips launching Ollama.
AI_PROVIDER_TYPE=ollama

# Hosted provider settings (groq/gemini/openai_compat). groq and gemini have
# built-in URL+model defaults; set AI_API_BASE_URL / AI_API_MODEL only to
# override them (or always, for openai_compat).
AI_API_KEY=
AI_API_BASE_URL=
AI_API_MODEL=

# Ollama AI Provider Configuration (AI_PROVIDER_TYPE=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=120
AI_MAX_RETRIES=3


# Debug: keep finished code-runner containers so they show in Docker Desktop (default false)
RUNNER_KEEP_CONTAINERS=false

# Browser origins allowed to call the API directly (JSON list). The Vite dev proxy does not need this.
CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]
