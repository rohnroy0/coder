PROJECT_NAME="Coder"
API_V1_STR="/api"

# SQLite is fine for a single-class deployment; the file lives next to the
# backend and is backed up by copying it. Switch to PostgreSQL only if you
# outgrow it.
DATABASE_URL=sqlite:///./ai_code_classroom.db

# __GENERATE__ placeholders are replaced with random values by setup-server.sh
SECRET_KEY=__GENERATE__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Required in production: teacher accounts can see every student's work.
# Give this code only to real teachers.
TEACHER_SIGNUP_CODE=__GENERATE__

# Hosted AI (Groq free tier). PASTE YOUR KEY HERE - the only value the setup
# script cannot generate for you. Create one free at console.groq.com.
AI_PROVIDER_TYPE=groq
AI_API_KEY=
AI_API_BASE_URL=
AI_API_MODEL=

# Browser origins allowed to call the API directly. With Caddy serving the
# frontend and API from the same domain this is belt-and-braces only.
CORS_ORIGINS=["https://__DOMAIN__"]

RUNNER_KEEP_CONTAINERS=false
